{
  "name": "agent-arcade",
  "version": "0.4.0-preview.1",
  "description": "One desktop home for AI companions, social accounts and agent tasks.",
  "main": "src/bootstrap.cjs",
  "private": true,
  "author": "Agent Arcade contributors",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.cjs",
    "test:transfer-helper": "npm --prefix deploy/transfer-helper test",
    "test:ui": "node scripts/smoke.cjs",
    "test:bot-ui": "node scripts/bot-smoke.cjs",
    "test:chat-ui": "node scripts/chat-ui-smoke.cjs",
    "test:work-ui": "node scripts/workbench-smoke.cjs",
    "probe:sqlite": "node scripts/sqlite-probe.cjs",
    "mcp:artifacts": "node src/mcp/server.cjs",
    "test:bot-flow": "node scripts/bot-flow.cjs",
    "test:native": "node scripts/native-smoke.cjs",
    "check": "node scripts/check.cjs",
    "prepack": "node scripts/build-icon.cjs",
    "pack": "electron-builder --dir",
    "predist": "node scripts/build-icon.cjs",
    "dist": "electron-builder --publish never",
    "prepack:mac": "node scripts/build-icon.cjs",
    "pack:mac": "electron-builder --dir --mac",
    "predist:mac": "node scripts/build-icon.cjs",
    "dist:mac": "electron-builder --mac --publish never",
    "test:persona-ui": "node scripts/persona-smoke.cjs",
    "test:providers-ui": "node scripts/providers-ui-smoke.cjs",
    "test:onboarding-ui": "node scripts/onboarding-ui-smoke.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ray0766/agent-arcade.git"
  },
  "homepage": "https://github.com/Ray0766/agent-arcade#readme",
  "bugs": "https://github.com/Ray0766/agent-arcade/issues",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "playwright": "1.64.1",
    "yazl": "3.3.1"
  },
  "build": {
    "appId": "io.github.agentarcade.desktop",
    "productName": "Agent Arcade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "LICENSE-MIT-HISTORICAL",
      "THIRD_PARTY_NOTICES.md",
      "LICENSES/**/*",
      "!node_modules/@anthropic-ai/claude-agent-sdk{,-*}/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*",
      "src/assets/voice/serena-reference.wav",
      "src/bot/native-channel.cjs",
      "src/core/personas.cjs"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/assets/app.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "src/assets/app-mac.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@larksuiteoapi/node-sdk": "1.76.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "1.5.4",
    "ws": "8.22.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.317"
  }
}
