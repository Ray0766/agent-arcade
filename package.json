{
  "name": "agent-arcade",
  "version": "0.3.0-preview.2",
  "description": "Give your Claude agent a task through WeChat. Watch real work in a tiny desktop workshop.",
  "main": "src/main.cjs",
  "private": true,
  "author": "Agent Arcade contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.cjs",
    "test:ui": "node scripts/smoke.cjs",
    "test:bot-ui": "node scripts/bot-smoke.cjs",
    "test:bot-flow": "node scripts/bot-flow.cjs",
    "test:native": "node scripts/native-smoke.cjs",
    "check": "node scripts/check.cjs",
    "prepack": "node scripts/build-icon.cjs",
    "pack": "electron-builder --dir",
    "predist": "node scripts/build-icon.cjs",
    "dist": "electron-builder --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ray0766/agent-arcade.git"
  },
  "homepage": "https://github.com/Ray0766/agent-arcade#readme",
  "bugs": "https://github.com/Ray0766/agent-arcade/issues",
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "io.github.agentarcade.desktop",
    "productName": "Agent Arcade",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "asarUnpack": ["node_modules/**/*","src/bot/native-channel.cjs"],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "src/assets/app.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.317",
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  }
}
