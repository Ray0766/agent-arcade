# Copy outside the repository, restrict to the relay service account/root,
# and fill every blank. Never place a Page access token on this relay.
MESSENGER_APP_ID=
MESSENGER_PAGE_ID=
MESSENGER_OWNER_ID=
MESSENGER_APP_SECRET=
MESSENGER_VERIFY_TOKEN=
MESSENGER_RELAY_TOKEN=
MESSENGER_RELAY_DATABASE=/var/lib/agent-arcade-messenger/relay.sqlite
MESSENGER_RELAY_PORT=8787
