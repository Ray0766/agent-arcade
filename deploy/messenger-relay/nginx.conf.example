# Include in the nginx http context after replacing the hostname/certificates.
# This is a deployment template, not an installed or TLS-tested service.
limit_conn_zone $binary_remote_addr zone=messenger_connections:1m;

server {
    listen 443 ssl;
    server_name messenger.example.invalid;
    ssl_certificate /etc/ssl/messenger/fullchain.pem;
    ssl_certificate_key /etc/ssl/messenger/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The verification GET contains the verify token. Do not log its query.
    access_log off;
    # Upstream error records can include request URIs, so disable this log too.
    # Monitor service availability separately without request/body capture.
    error_log /dev/null;
    client_max_body_size 256k;
    client_header_timeout 5s;
    client_body_timeout 5s;
    keepalive_timeout 5s;
    limit_conn messenger_connections 16;

    location ~ ^/(webhook|v1/(status|pull|ack))$ {
        limit_except GET POST { deny all; }
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_next_upstream off;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }
    location / { return 404; }
}
