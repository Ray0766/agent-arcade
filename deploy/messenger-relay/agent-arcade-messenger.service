# Optional Linux deployment template. Not installed or enabled by the app.
[Unit]
Description=Agent Arcade Messenger Page relay
After=network.target

[Service]
Type=simple
User=agent-arcade-relay
Group=agent-arcade-relay
WorkingDirectory=/opt/agent-arcade
EnvironmentFile=/etc/agent-arcade-messenger.env
ExecStart=/usr/bin/node /opt/agent-arcade/scripts/messenger-relay.cjs
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/agent-arcade-messenger

[Install]
WantedBy=multi-user.target
