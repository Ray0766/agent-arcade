+export function firstHomeFurnitureHit(ray: T.Raycaster, roots: T.Object3D[], furniture: T.Group) {
+  for (const hit of ray.intersectObjects(roots)) {
+    if (!(hit.object instanceof T.Mesh)) continue;
+    const material = Array.isArray(hit.object.material) ? hit.object.material[hit.face?.materialIndex ?? 0] : hit.object.material;
+    if (!material?.visible || (material.transparent && material.opacity === 0)) continue;
+    let visible = true;
+    let itemId: string | undefined;
+    for (let node: T.Object3D | null = hit.object; node; node = node.parent) {
+      if (!node.visible) { visible = false; break; }
+      if (node.parent === furniture) itemId = node.userData.homeItem;
+    }
+    if (!visible) continue;
+    return itemId;
+  }
+}
